+// 5H: automatic target voltage calibration (foreground only).
+typedef enum {
+    AutoCal_Off = 0,
+    AutoCal_Skip,
+    AutoCal_Settle,
+    AutoCal_Sample,
+    AutoCal_Done
+} autocal_phase_t;
+
+static struct {
+    autocal_phase_t phase;
+    float window, ref, center;
+    float dist, phase_dist, sum;
+    float buf[PLASMA_THC_AUTOCAL_SETTLE_N];
+    uint_fast8_t n, idx;
+    uint32_t count, last_tick, last_id;
+} autocal = {};
 static material_t *materials = NULL;
 static struct {
     int32_t id;
@@ -1203,6 +1247,137 @@ static void set_target_voltage (float v)
     reset_control_filter();
 }
 
+// 5H ------------------------------------------------------------------------
+static void autocal_report (const char *result, float value)
+{
+    char message[96];
+    if(isfinite(value))
+        snprintf(message, sizeof(message), "THC AUTO V=%.1f REF=%.1f W=%.0f %s", value, autocal.ref, autocal.window, result);
+    else
+        snprintf(message, sizeof(message), "THC AUTO SIN DATO REF=%.1f %s", autocal.ref, result);
+    report_message(message, Message_Plain);
+}
+
+static void autocal_abort (const char *reason)
+{
+    if(autocal.phase != AutoCal_Off && autocal.phase != AutoCal_Done)
+        autocal_report(reason, NAN);
+    autocal.phase = AutoCal_Off;
+}
+
+static void autocal_arm (float window, float ref)
+{
+    memset(&autocal, 0, sizeof(autocal));
+    autocal.window = window;
+    autocal.ref = ref;
+    autocal.phase = AutoCal_Skip;
+}
+
+static inline bool autocal_running (void)
+{
+    return autocal.phase == AutoCal_Skip || autocal.phase == AutoCal_Settle || autocal.phase == AutoCal_Sample;
+}
+
+static void autocal_finish_manual (const char *reason, float value)
+{
+    autocal.phase = AutoCal_Done;
+    autocal_report(reason, value);
+    reset_control_filter();     // THC starts with the manual target
+}
+
+// Called from state_thc_pid() only (THC active = at cutting speed); Z is held meanwhile.
+static void autocal_step (void)
+{
+    uint32_t now = hal.get_elapsed_ticks();
+    uint32_t dt = autocal.last_tick ? (uint32_t)(now - autocal.last_tick) : 0;
+    autocal.last_tick = now;
+    if(dt > 100)    // came back from a slow-down/lock: do not count the gap
+        dt = 0;
+    autocal.dist += fr_actual * (float)dt / 60000.0f;
+
+    bool fresh = autocal.last_id != arc_voltage_sample_id;
+    autocal.last_id = arc_voltage_sample_id;
+    float v = arc_voltage;
+    if(!arc_voltage_valid || !isfinite(v) || v < PLASMA_VOLTAGE_MONITOR_MIN_ACTIVE)
+        fresh = false;
+
+    switch(autocal.phase) {
+
+        case AutoCal_Skip:
+            if(autocal.dist >= PLASMA_THC_AUTOCAL_SKIP_MM) {
+                autocal.phase = AutoCal_Settle;
+                autocal.phase_dist = autocal.dist;
+                autocal.n = autocal.idx = 0;
+            }
+            break;
+
+        case AutoCal_Settle:
+            if(fresh && fabsf(v - autocal.ref) <= autocal.window + 15.0f) {
+                autocal.buf[autocal.idx++] = v;
+                if(autocal.idx == PLASMA_THC_AUTOCAL_SETTLE_N)
+                    autocal.idx = 0;
+                if(autocal.n < PLASMA_THC_AUTOCAL_SETTLE_N)
+                    autocal.n++;
+                if(autocal.n == PLASMA_THC_AUTOCAL_SETTLE_N) {
+                    // Ring buffer: idx points to the oldest sample.
+                    const uint_fast8_t half = PLASMA_THC_AUTOCAL_SETTLE_N / 2;
+                    float older = 0.0f, newer = 0.0f;
+                    for(uint_fast8_t i = 0; i < PLASMA_THC_AUTOCAL_SETTLE_N; i++) {
+                        float x = autocal.buf[(autocal.idx + i) % PLASMA_THC_AUTOCAL_SETTLE_N];
+                        if(i < half)
+                            older += x;
+                        else
+                            newer += x;
+                    }
+                    older /= (float)half;
+                    newer /= (float)(PLASMA_THC_AUTOCAL_SETTLE_N - half);
+                    float mean = (older * (float)half + newer * (float)(PLASMA_THC_AUTOCAL_SETTLE_N - half)) / (float)PLASMA_THC_AUTOCAL_SETTLE_N;
+                    float var = 0.0f;
+                    for(uint_fast8_t i = 0; i < PLASMA_THC_AUTOCAL_SETTLE_N; i++)
+                        var += (autocal.buf[i] - mean) * (autocal.buf[i] - mean);
+                    var /= (float)PLASMA_THC_AUTOCAL_SETTLE_N;
+                    if(fabsf(newer - older) <= PLASMA_THC_AUTOCAL_SETTLE_DRIFT_V &&
+                        var <= PLASMA_THC_AUTOCAL_SETTLE_STD_V * PLASMA_THC_AUTOCAL_SETTLE_STD_V) {
+                        autocal.center = mean;
+                        autocal.phase = AutoCal_Sample;
+                        autocal.phase_dist = autocal.dist;
+                        autocal.sum = 0.0f;
+                        autocal.count = 0;
+                        break;
+                    }
+                }
+            }
+            if(autocal.dist - autocal.phase_dist > PLASMA_THC_AUTOCAL_SETTLE_MAX_MM)
+                autocal_finish_manual("MANUAL (no se estabilizo)", NAN);
+            break;
+
+        case AutoCal_Sample:
+            if(fresh && fabsf(v - autocal.center) <= PLASMA_THC_AUTOCAL_SPIKE_V) {
+                autocal.sum += v;
+                autocal.count++;
+            }
+            if(autocal.dist - autocal.phase_dist >= PLASMA_THC_AUTOCAL_SAMPLE_MM) {
+                if(autocal.count < PLASMA_THC_AUTOCAL_MIN_SAMPLES) {
+                    autocal_finish_manual("MANUAL (pocas muestras)", NAN);
+                    break;
+                }
+                float mean = autocal.sum / (float)autocal.count;
+                if(fabsf(mean - autocal.ref) <= autocal.window) {
+                    autocal.phase = AutoCal_Done;
+                    job.param.cut_voltage = mean;
+                    set_target_voltage(mean);
+                    autocal_report("OK", mean);
+                } else
+                    autocal_finish_manual("FUERA (se usa manual)", mean);
+            }
+            break;
+
+        default:
+            break;
+    }
+}
