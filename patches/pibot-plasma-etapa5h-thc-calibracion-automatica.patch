+// 5H: automatic calibration of the target voltage, (THC:PREPARE,G=..,V=..[,L=..],A=<window V>).
+// After THC start: skip SKIP_MM of travel, wait until the voltage is stable (no trend between
+// the two halves of the last SETTLE_N samples and normal noise, within SETTLE_MAX_MM), then average SAMPLE_MM of
+// travel at cutting speed with Z held. The mean replaces V if |mean - V| <= window.
+#ifndef PLASMA_THC_AUTOCAL_SKIP_MM
+#define PLASMA_THC_AUTOCAL_SKIP_MM       10.0f
+#endif
+#ifndef PLASMA_THC_AUTOCAL_SAMPLE_MM
+#define PLASMA_THC_AUTOCAL_SAMPLE_MM     30.0f
+#endif
+#ifndef PLASMA_THC_AUTOCAL_SETTLE_MAX_MM
+#define PLASMA_THC_AUTOCAL_SETTLE_MAX_MM 40.0f
+#endif
+#ifndef PLASMA_THC_AUTOCAL_SETTLE_DRIFT_V
+#define PLASMA_THC_AUTOCAL_SETTLE_DRIFT_V 2.0f   // |mean newer half - mean older half|
+#endif
+#ifndef PLASMA_THC_AUTOCAL_SETTLE_STD_V
+#define PLASMA_THC_AUTOCAL_SETTLE_STD_V   5.0f   // normal reading noise is ~3 V
+#endif
+#ifndef PLASMA_THC_AUTOCAL_SPIKE_V
+#define PLASMA_THC_AUTOCAL_SPIKE_V       12.0f
+#endif
+#define PLASMA_THC_AUTOCAL_SETTLE_N      12      // ~0.5 s at 25 Hz
+#define PLASMA_THC_AUTOCAL_MIN_SAMPLES   10
+#define PLASMA_THC_AUTOCAL_WINDOW_MIN_V  3.0f
+#define PLASMA_THC_AUTOCAL_WINDOW_MAX_V  30.0f
 // Digital ports
 #define PLASMA_THC_DISABLE_PORT         2 // output
 #define PLASMA_TORCH_DISABLE_PORT       3 // output
@@ -282,6 +308,24 @@ static float thc_start_z = 0.0f;
 static float thc_limit_mm = PLASMA_THC_MAX_OFFSET_MM;   // symmetric tracking limit around thc_start_z
 static bool thc_limit_active = false;                    // true only when the job sent L=
 static uint32_t material_id = PLASMA_TMP_MATERIAL_ID_START;
