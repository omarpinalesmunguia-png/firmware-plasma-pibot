+// PiBot plasma: release dead WiFi clients quickly so the sender can reconnect
+// after the controlling computer leaves and rejoins the controller access point.
+#ifndef NETWORK_KEEPALIVE_IDLE
+#define NETWORK_KEEPALIVE_IDLE      5000 // ms before the first keepalive probe
+#endif
+#ifndef NETWORK_KEEPALIVE_INTERVAL
+#define NETWORK_KEEPALIVE_INTERVAL  2000 // ms between probes
+#endif
+#ifndef NETWORK_KEEPALIVE_COUNT
+#define NETWORK_KEEPALIVE_COUNT     3    // unanswered probes before disconnect
+#endif
+
 //*****************************************************************************
 
 #ifndef LINK_CHECK_INTERVAL
