diff --git a/networking.h b/networking.h
index 2740372..f783c29 100644
--- a/networking.h
+++ b/networking.h
@@ -64,6 +64,18 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #define TCP_SLOW_INTERVAL 500
 #endif
 
+// PiBot plasma: release dead WiFi clients quickly so the sender can reconnect
+// after the controlling computer leaves and rejoins the controller access point.
+#ifndef NETWORK_KEEPALIVE_IDLE
+#define NETWORK_KEEPALIVE_IDLE      5000 // ms before the first keepalive probe
+#endif
+#ifndef NETWORK_KEEPALIVE_INTERVAL
+#define NETWORK_KEEPALIVE_INTERVAL  2000 // ms between probes
+#endif
+#ifndef NETWORK_KEEPALIVE_COUNT
+#define NETWORK_KEEPALIVE_COUNT     3    // unanswered probes before disconnect
+#endif
+
 //*****************************************************************************
 
 #ifndef LINK_CHECK_INTERVAL
diff --git a/telnetd.c b/telnetd.c
index 31e2c31..6357595 100644
--- a/telnetd.c
+++ b/telnetd.c
@@ -406,21 +406,19 @@ FLASHMEM static err_t telnet_accept (void *arg, struct tcp_pcb *pcb, err_t err)
 
     sessiondata_t *session = arg;
 
-    if(session->pcb)
-        return ERR_CONN; // Busy, refuse connection
-
     if(telnet_server.link_lost) {
-        // Link was previously lost, abort current connection
-
-        tcp_abort(session->pcb);
-
-        telnet_state_free(session);
+        // Clear a connection retained across a previous link loss before
+        // deciding whether the server is busy. session->pcb may already be
+        // NULL when the link-down handler closed it.
+        if(session->pcb)
+            telnet_close_conn(session, session->pcb);
 
         telnet_server.link_lost = false;
-
-        return ERR_ABRT;
     }
 
+    if(session->pcb)
+        return ERR_CONN; // Busy, refuse connection
+
     streamClose(session);
 
     memcpy(session, &defaultSettings, sizeof(sessiondata_t));
@@ -435,7 +433,11 @@ FLASHMEM static err_t telnet_accept (void *arg, struct tcp_pcb *pcb, err_t err)
     tcp_sent(pcb, telnet_sent);
     tcp_arg(pcb, &streamSession);
 #if LWIP_TCP_KEEPALIVE
-//??    pcb->keep_idle = pcb->keep_intvl = 3000;
+    // Detect an unreachable WiFi client in about 11 seconds instead of
+    // retaining the only Telnet session for the lwIP default (up to hours).
+    pcb->keep_idle = NETWORK_KEEPALIVE_IDLE;
+    pcb->keep_intvl = NETWORK_KEEPALIVE_INTERVAL;
+    pcb->keep_cnt = NETWORK_KEEPALIVE_COUNT;
     ip_set_option(pcb, SOF_KEEPALIVE);
 #endif
 
