--- a/telnetd.c
+++ b/telnetd.c
@@ -435,6 +435,10 @@ FLASHMEM static err_t telnet_accept (void *arg, struct tcp_pcb *pcb, err_t err)
     tcp_sent(pcb, telnet_sent);
     tcp_arg(pcb, &streamSession);
 #if LWIP_TCP_KEEPALIVE
-//??    pcb->keep_idle = pcb->keep_intvl = 3000;
+    // Detect an unreachable WiFi client in about 11 seconds instead of
+    // retaining the only Telnet session for the lwIP default (up to hours).
+    pcb->keep_idle = NETWORK_KEEPALIVE_IDLE;
+    pcb->keep_intvl = NETWORK_KEEPALIVE_INTERVAL;
+    pcb->keep_cnt = NETWORK_KEEPALIVE_COUNT;
