+static inline void update_arc_voltage_monitor (bool arc_active)
+{
+#if PLASMA_VOLTAGE_MONITOR_ONLY
+    static uint_fast8_t sample_ticks = 0;
+    uint32_t now = hal.get_elapsed_ticks();
+
+    if(!voltage_monitor_available || (int32_t)(now - voltage_monitor_retry_at) < 0)
+        return;
+
+    if(++sample_ticks >= PLASMA_VOLTAGE_MONITOR_SAMPLE_TICKS) {
+        sample_ticks = 0;
+
+        float raw = parc_voltage.get_value(&parc_voltage);
+        float measured = raw < 0.0f || isnanf(raw)
+            ? -1.0f
+            : (raw - plasma.arc_voltage_offset) * plasma.arc_voltage_scale;
+
+        if(measured < 0.0f || (arc_active && measured < PLASMA_VOLTAGE_MONITOR_MIN_ACTIVE)) {
+            if(++voltage_monitor_failures >= PLASMA_VOLTAGE_MONITOR_MAX_FAILURES) {
+                voltage_monitor_failures = 0;
+                voltage_monitor_retry_at = now + PLASMA_VOLTAGE_MONITOR_RETRY_TICKS;
+                arc_voltage = -1.0f;
+                arc_voltage_valid = false;
+                arc_voltage_sample_id++;
+            }
+        } else {
+            voltage_monitor_failures = 0;
+            voltage_monitor_retry_at = 0;
+            arc_voltage = measured;
+            arc_voltage_valid = true;
+            arc_voltage_sample_id++;
+        }
+    }
+#endif
+}
+
+static void reset_control_filter (void)
+{
+    control_sample_count = control_sample_index = 0;
+    control_sample_id = arc_voltage_sample_id;
+    control_voltage = 0.0f;
+    thc.void_lock = Off;
+}
+
+static float median_control_voltage (void)
+{
+    float sorted[THC_SAMPLE_AVG];
+    memcpy(sorted, control_samples, sizeof(sorted));
+
+    for(uint_fast8_t i = 1; i < THC_SAMPLE_AVG; i++) {
+        float value = sorted[i];
+        uint_fast8_t j = i;
+        while(j && sorted[j - 1] > value) {
+            sorted[j] = sorted[j - 1];
+            j--;
+        }
+        sorted[j] = value;
+    }
+
+    return sorted[THC_SAMPLE_AVG / 2];
+}
+
+static bool get_filtered_control_voltage (float *filtered)
+{
+    if(control_sample_id == arc_voltage_sample_id)
+        return false;
+
+    control_sample_id = arc_voltage_sample_id;
+
+    if(!arc_voltage_valid || !isfinite(arc_voltage) ||
+       arc_voltage < PLASMA_VOLTAGE_MONITOR_MIN_ACTIVE ||
+       fabsf(arc_voltage - arc_vref) > PLASMA_THC_MAX_CONTROL_ERROR_V) {
+        thc.void_lock = On;
+        return false;
+    }
+
+    if(control_sample_count == THC_SAMPLE_AVG) {
+        float median = median_control_voltage();
+        if(fabsf(arc_voltage - median) > PLASMA_THC_OUTLIER_DELTA_V) {
+            thc.void_lock = On;
+            return false;
+        }
+    }
+
+    control_samples[control_sample_index++] = arc_voltage;
+    if(control_sample_index == THC_SAMPLE_AVG)
+        control_sample_index = 0;
+    if(control_sample_count < THC_SAMPLE_AVG)
+        control_sample_count++;
+    if(control_sample_count < THC_SAMPLE_AVG)
+        return false;
+
+    control_voltage = median_control_voltage();
+    thc.void_lock = Off;
+    *filtered = control_voltage;
+
+    return true;
+}
