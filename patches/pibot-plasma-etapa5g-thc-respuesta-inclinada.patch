         thc.void_lock = On;
         return false;
     }
 
+    if(arc_vref - arc_voltage > PLASMA_THC_MAX_CONTROL_ERROR_V) {
+        thc.void_lock = Off;
+        *filtered = arc_voltage;   // too close: react at once, no filter delay
+        return true;
+    }
+
     if(control_sample_count == THC_SAMPLE_AVG) {
         float median = median_control_voltage();
-        if(fabsf(arc_voltage - median) > PLASMA_THC_OUTLIER_DELTA_V) {
