+#ifndef PLASMA_THC_GAIN_MM_PER_V
+#define PLASMA_THC_GAIN_MM_PER_V        0.02f
+#endif
+#ifndef PLASMA_THC_MIN_STEP_MM
+#define PLASMA_THC_MIN_STEP_MM          0.03f
+#endif
