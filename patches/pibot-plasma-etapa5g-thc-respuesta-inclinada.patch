 #endif
@@ -1030,16 +1041,26 @@ static bool get_filtered_control_voltage (float *filtered)
 
     control_sample_id = arc_voltage_sample_id;
 
+    // 5G: asymmetric protection. A voltage far ABOVE target (kerf crossing, hole, plate
+    // edge, arc stretching) would drive the torch down: freeze. A voltage far BELOW
+    // target means the torch is too close (plate rising, warp): never freeze, the
+    // correction is upwards, which is the safe direction (still bounded by +L).
     if(!arc_voltage_valid || !isfinite(arc_voltage) ||
        arc_voltage < PLASMA_VOLTAGE_MONITOR_MIN_ACTIVE ||
-       fabsf(arc_voltage - arc_vref) > PLASMA_THC_MAX_CONTROL_ERROR_V) {
