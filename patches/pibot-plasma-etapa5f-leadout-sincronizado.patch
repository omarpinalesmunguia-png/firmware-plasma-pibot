             return Status_SettingDisabled;
 
+        // 5F: in a file job the preceding moves may still be queued with the cycle not yet
+        // started; checking the state before synchronizing depended on planner timing.
+        if(!protocol_buffer_synchronize() || cutting_spindle || state_get() != STATE_IDLE)
+            return Status_GcodeUnsupportedCommand;
+
+        // 5F: (THC:PREPARE,G=<ms>) without V= -> cut managed by the host WITHOUT THC
+        // (fixed height, 3D height map, small contours): Z is never claimed, so the
+        // programmed Z moves of a height map are executed, and arc ok gets its grace time.
+        if(voltage == 0.0f) {
+            thc_limit_reset();
+            host_managed = true;
+            waiting_for_cut_height = false;
+            floating_head_collision = false;
+            floating_head_samples = 0;
+            arc_grace_ms = (uint32_t)grace;
+            job.thc_disabled = true;
+            job.arc_ok_ignore = false;
+            return Status_OK;
+        }
+
         // Everything validated: only now change the tracking limit.
         if(has_limit) {
             thc_limit_mm = limit;
@@ -1239,8 +1281,9 @@ static status_code_t thc_host_command (char *command)
     }
 
     if(!strcmp(command, "READY")) {
-        if(!host_managed || !waiting_for_cut_height || !cutting_spindle || state_get() != STATE_IDLE || release_z_pending)
+        if(!host_managed || !waiting_for_cut_height || !cutting_spindle || release_z_pending)
             return Status_GcodeUnsupportedCommand;
+        // 5F: synchronize first (move to cut height finishes), then check the state.
         if(!protocol_buffer_synchronize() || !cutting_spindle || state_get() != STATE_IDLE)
             return Status_GcodeUnsupportedCommand;
         waiting_for_cut_height = false;
@@ -1249,10 +1292,14 @@ static status_code_t thc_host_command (char *command)
         return Status_OK;
     }
 
-    if(!strcmp(command, "OFF") || !strcmp(command, "LEADOUT")) {
-        bool leadout = !strcmp(command, "LEADOUT");
