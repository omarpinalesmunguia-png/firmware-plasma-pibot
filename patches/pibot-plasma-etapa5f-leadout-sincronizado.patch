-            return Status_GcodeUnsupportedCommand;
+    if(!strcmp(command, "LEADOUT")) {
+        // Stand-alone line (no motion on it): applied at once. On a motion line it is
+        // handled by onProcessGcodeComment()/onGcodeMessage() when that block starts.
+        thc_leadout();
+        return Status_OK;
+    }
+
+    if(!strcmp(command, "OFF")) {
         task_delete(thc_start, NULL);
         waiting_for_cut_height = false;
         job.thc_disabled = true;
@@ -1310,6 +1357,36 @@ static void thc_start (void *data)
     }
 }
 
+// 5F: (THC:LEADOUT) on a motion line. Returning a message attaches it to that planner
+// block; grblHAL outputs block messages through grbl.on_gcode_message (foreground task)
+// when the block starts executing, so the lead-out is applied exactly at the start of the
+// lead-out move. On a line without motion the message is output at once.
+static char *onProcessGcodeComment (char *comment)
+{
+    if(comment && !strcmp(comment, "THC:LEADOUT")) {
+        char *marker = malloc(sizeof(THC_LEADOUT_MARKER));
+        if(marker) {
+            strcpy(marker, THC_LEADOUT_MARKER);
+            *comment = '\0'; // do not raise grbl.on_gcode_comment for it
+            return marker;
+        }
+        // Out of memory: falls through to the immediate (stand-alone) handling.
+    }
+
+    return on_process_gcode_comment ? on_process_gcode_comment(comment) : NULL;
+}
+
+static status_code_t onGcodeMessage (char *msg)
+{
+    if(msg && !strcmp(msg, THC_LEADOUT_MARKER)) {
+        thc_leadout();
+        *msg = '\0'; // no [MSG:] output
+        return Status_OK;
+    }
+
+    return on_gcode_message ? on_gcode_message(msg) : Status_OK;
+}
