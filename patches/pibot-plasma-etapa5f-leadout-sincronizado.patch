+// 5F: lead-out. Freezes Z where it is and stops THC corrections, arc ok supervision stays.
+// Runs in the foreground: never from an ISR (no FPU restrictions), never blocks, never
+// returns an error (an error would end a TF job with the torch on).
+static void thc_leadout (void)
+{
+    if(!host_managed || !cutting_spindle)
+        return;
+
+    task_delete(thc_start, NULL);
+    waiting_for_cut_height = false;
+    job.thc_disabled = true;
+    thc.enabled = thc.active = thc.void_lock = Off;
+    release_z();    // finish_z_release() completes it from the state machine
+    stateHandler = state_arc_monitor;
+}
+
 static status_code_t thc_host_command (char *command)
 {
     if(!strcmp(command, "INFO")) {
-        report_message("THC control 1", Message_Plain);
+        report_message("THC control 2", Message_Plain); // 2: PREPARE sin V=, LEADOUT sincronizado con el movimiento (5F)
         return Status_OK;
     }
 
@@ -1196,7 +1218,7 @@ static status_code_t thc_host_command (char *command)
         uint_fast8_t pos = 8;
         float grace, voltage = 0.0f, limit = 0.0f;
         bool has_limit = false;
-        if(cutting_spindle || state_get() != STATE_IDLE || strncmp(command + pos, "G=", 2))
+        if(cutting_spindle || strncmp(command + pos, "G=", 2))
             return Status_GcodeUnsupportedCommand;
         pos += 2;
         if(!read_float(command, &pos, &grace) || grace < 0.0f || grace > 4000.0f)
@@ -1217,9 +1239,29 @@ static status_code_t thc_host_command (char *command)
                 has_limit = true;
             }
